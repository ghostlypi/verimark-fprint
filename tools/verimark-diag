#!/usr/bin/python3
"""Diagnostics for the Kensington VeriMark Desktop 2.0 libfprint driver.

Talks to the device through libfprint itself, so it exercises the same code
path fprintd and GNOME use. Run as root, or as a user with access to the
device node.
"""
import argparse
import os
import sys

try:
    import gi
    gi.require_version("FPrint", "2.0")
    from gi.repository import FPrint, GLib
except (ImportError, ValueError) as exc:
    sys.exit(f"verimark-diag: python3-gobject with FPrint typelib is required ({exc})")

DRIVER_ID = "verimark"


# The context owns the USB context the devices live on, so it has to outlive
# every device handed out. Keeping it in a module global is the simplest way
# to guarantee that against Python's garbage collector.
_CONTEXT = None


def get_device(any_driver=False):
    global _CONTEXT

    _CONTEXT = FPrint.Context()
    _CONTEXT.enumerate()
    devices = _CONTEXT.get_devices()

    if not devices:
        sys.exit("No fingerprint devices found.\n"
                 "  - is the reader plugged in?  (lsusb | grep 047d:8228)\n"
                 "  - is the driver installed?   "
                 "(ls /usr/lib64/libfprint-2/tod-1/)")

    for dev in devices:
        if any_driver or dev.get_driver() == DRIVER_ID:
            return dev

    found = ", ".join(d.get_driver() for d in devices)
    sys.exit(f"Found fingerprint devices ({found}) but none using the "
             f"'{DRIVER_ID}' driver.")


def cmd_info(args):
    dev = get_device(args.any)
    print(f"driver        : {dev.get_driver()}")
    print(f"device id     : {dev.get_device_id()}")
    print(f"name          : {dev.get_name()}")
    print(f"scan type     : {dev.get_scan_type().value_nick}")
    print(f"enroll stages : {dev.get_nr_enroll_stages()}")
    print(f"has storage   : {dev.has_feature(FPrint.DeviceFeature.STORAGE)}")
    print(f"has identify  : {dev.has_feature(FPrint.DeviceFeature.IDENTIFY)}")

    print("\nopening (this runs the SDCP handshake)...")
    dev.open_sync()
    print("  session established")

    prints = dev.list_prints_sync()
    print(f"\ntemplates stored on the sensor: {len(prints)}")
    for i, p in enumerate(prints):
        print(f"  [{i}] finger={p.get_finger().value_nick} "
              f"username={p.get_username()!r}")

    dev.close_sync()
    print("\nclosed cleanly")


def cmd_verify(args):
    dev = get_device(args.any)
    dev.open_sync()
    prints = dev.list_prints_sync()

    if not prints:
        dev.close_sync()
        sys.exit("No templates on the sensor — nothing to match against.")

    print(f"{len(prints)} template(s) enrolled.")
    print(">>> touch the sensor", flush=True)

    match, _ = dev.identify_sync(prints)
    if match:
        print(f"MATCH: template index {prints.index(match)}")
    else:
        print("no match")

    dev.close_sync()


def cmd_enroll(args):
    dev = get_device(args.any)
    dev.open_sync()

    stages = dev.get_nr_enroll_stages()
    print(f"Enrolling. Touch and lift {stages} times.", flush=True)

    template = FPrint.Print.new(dev)
    template.set_finger(FPrint.Finger.LEFT_INDEX)
    template.set_username(args.user)

    def progress(_dev, completed, _print, error, _data=None):
        if error:
            print(f"  retry ({error.message})", flush=True)
        else:
            print(f"  {completed}/{stages}", flush=True)

    try:
        dev.enroll_sync(template, None, progress, None)
        print("ENROLLED")
    except GLib.Error as exc:
        print(f"enrollment failed: {exc.message}")
    finally:
        dev.close_sync()


FPRINT_STORE = "/var/lib/fprint"


def parse_finger(name):
    """'right-index-finger', 'right-index' and 'RIGHT_INDEX' all work."""
    key = name.upper().replace("-", "_")
    if key.endswith("_FINGER"):
        key = key[: -len("_FINGER")]
    finger = getattr(FPrint.Finger, key, None)
    if finger is None or key == "UNKNOWN":
        valid = ", ".join(f.lower().replace("_", "-")
                          for f in dir(FPrint.Finger)
                          if f.isupper() and f != "UNKNOWN")
        sys.exit(f"verimark-diag: unknown finger {name!r}.\nTry one of: {valid}")
    return finger


def cmd_adopt(args):
    """Register a template that is already on the sensor with fprintd.

    The sensor stores templates on-chip and hands them back from list_prints
    with everything needed to match them. What fprintd additionally keeps is a
    host-side note of which template belongs to which user and finger — that,
    and only that, is what a template enrolled elsewhere (under Windows, or by
    another Linux user) is missing. This writes that note.
    """
    finger = parse_finger(args.finger)
    dev = get_device(args.any)
    dev.open_sync()

    try:
        prints = dev.list_prints_sync()
        if not prints:
            sys.exit("No templates on the sensor — nothing to adopt.")

        if args.no_touch:
            if args.index is None and len(prints) > 1:
                sys.exit(f"{len(prints)} templates on the sensor. Re-run without "
                         f"--no-touch to pick one by touching it, or pass "
                         f"--index 0..{len(prints) - 1}.")
            chosen = prints[args.index or 0]
        else:
            print(f"{len(prints)} template(s) on the sensor.")
            print(f">>> touch the sensor with the finger you want registered "
                  f"as '{args.finger}'", flush=True)
            chosen, _ = dev.identify_sync(prints)
            if chosen is None:
                sys.exit("That finger does not match any template on the sensor.\n"
                         "It is not enrolled — use 'fprintd-enroll' instead.")
            print(f"matched template index {prints.index(chosen)}")

        chosen.set_finger(finger)
        chosen.set_username(args.user)
        blob = chosen.serialize()
    finally:
        dev.close_sync()

    path = os.path.join(FPRINT_STORE, args.user, dev.get_driver(),
                        dev.get_device_id())
    os.makedirs(path, mode=0o700, exist_ok=True)
    target = os.path.join(path, str(int(finger)))

    if os.path.exists(target) and not args.force:
        sys.exit(f"{target} already exists — pass --force to replace it.")

    with open(target, "wb") as fh:
        fh.write(blob)
    os.chmod(target, 0o644)

    print(f"\nregistered as {args.finger} for user {args.user}")
    print(f"  {target}")
    print("\nRestart fprintd so it picks this up:")
    print("  sudo systemctl try-restart fprintd")


def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--any", action="store_true",
                        help="use whatever fingerprint device is present, not "
                             "just the VeriMark")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("info", help="show device details and stored templates")
    p.set_defaults(func=cmd_info)

    p = sub.add_parser("verify", help="touch the sensor and report the match")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("enroll", help="enroll a finger (test harness; prefer "
                                      "GNOME Settings or fprintd-enroll)")
    p.add_argument("--user", default="verimark-diag-test")
    p.set_defaults(func=cmd_enroll)

    p = sub.add_parser("adopt",
                       help="register a template already on the sensor (e.g. one "
                            "enrolled under Windows) with fprintd, without "
                            "re-enrolling it")
    p.add_argument("--finger", required=True,
                   help="which finger this template is, e.g. right-index-finger")
    p.add_argument("--user", default=os.environ.get("SUDO_USER") or
                   os.environ.get("USER"),
                   help="user to register it for (default: the invoking user)")
    p.add_argument("--no-touch", action="store_true",
                   help="do not ask for a touch; requires a single template or "
                        "--index")
    p.add_argument("--index", type=int,
                   help="template index from 'verimark-diag info', with --no-touch")
    p.add_argument("--force", action="store_true",
                   help="replace an existing record for this finger")
    p.set_defaults(func=cmd_adopt)

    args = parser.parse_args()
    if not args.command:
        args.func = cmd_info

    try:
        args.func(args)
    except GLib.Error as exc:
        sys.exit(f"libfprint error: {exc.message}")


if __name__ == "__main__":
    main()
